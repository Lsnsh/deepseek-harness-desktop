{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Developer Preview",
  "version": "0.1.0-beta.1",
  "identifier": "com.lsnsh.deepseek-harness-desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop client",
    "longDescription": "A native desktop client for DeepSeek Harness: bundles its own Node.js runtime and the built web server, and hosts the GUI in a native window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/runtime.tar.gz"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Lsnsh/deepseek-harness-desktop/releases/download/updater-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBNUE4RTAwNDdCMEFCMUIKUldRYnE3QkhBSTVheXNnVVdOUmUzTWsxOHNGUUx4eEhEYktPYTRuMkt3UFZDVzhjWVhDbUhIaE8K"
    }
  }
}
